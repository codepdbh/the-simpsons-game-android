diff --git a/simpsons/src/frame_pacing.cpp b/simpsons/src/frame_pacing.cpp
index f4222377..c6848a15 100644
--- a/simpsons/src/frame_pacing.cpp
+++ b/simpsons/src/frame_pacing.cpp
@@ -74,7 +74,7 @@ REXCVAR_DEFINE_BOOL(present_late_frames_immediately, true, "GPU",
                     "without tearing either way");
 
 // freecam.cpp: whether the photo mode has paused the level.
-bool FreecamWorldFrozen();
+// Android currently has no desktop free-camera overlay or world-freeze mode.
 
 // Steps the Havok world by f1 seconds of frame time. Runs every frame while a
 // level is live and never in the front end.
@@ -200,7 +200,7 @@ namespace {
 
 // Whether menu logic runs on its own cadence: menu rates above 30 fps.
 bool MenuLogicCadence() {
-  if (!g_in_menu || FreecamWorldFrozen()) {
+  if (!g_in_menu) {
     return false;
   }
   const int32_t rate = ActiveFrameRate();
@@ -308,7 +308,7 @@ REX_FUNC(sub_82718710) {
     int64_t last_step = g_last_level_step_ns.load(std::memory_order_relaxed);
     // The photo mode pauses the level, which stops the physics step too; it is
     // still a level and keeps the gameplay frame rate.
-    g_in_menu = (!last_step || NowNs() - last_step > kMenuAfterNs) && !FreecamWorldFrozen();
+    g_in_menu = (!last_step || NowNs() - last_step > kMenuAfterNs);
     uint32_t refresh_bits = LoadGuestU32(base, kSchedulerRefreshHz);
     float refresh_hz;
     std::memcpy(&refresh_hz, &refresh_bits, sizeof(refresh_hz));
@@ -381,6 +381,32 @@ REX_FUNC(sub_82718710) {
 
 REX_FUNC(sub_82718788) {
   __imp__sub_82718788(ctx, base);
+  // Host scheduler cadence, not presentation FPS. Ignore lifecycle gaps so
+  // returning from the launcher does not count as a gameplay stall.
+  using HostClock = std::chrono::steady_clock;
+  static thread_local auto previous = HostClock::now();
+  static thread_local double total_ms = 0, maximum_ms = 0;
+  static thread_local uint32_t samples = 0, slow_frames = 0;
+  const auto now = HostClock::now();
+  const double ms = std::chrono::duration<double, std::milli>(now - previous).count();
+  previous = now;
+  if (ms > 1000) {
+    total_ms = maximum_ms = 0;
+    samples = slow_frames = 0;
+  } else if (ms > 0) {
+    total_ms += ms;
+    maximum_ms = std::max(maximum_ms, ms);
+    ++samples;
+    const int target = g_in_menu ? REXCVAR_GET(menu_frame_rate) : REXCVAR_GET(frame_rate);
+    if (target > 0 && ms > 1500.0 / target) ++slow_frames;
+    if (total_ms >= 5000) {
+      REXLOG_INFO("TSG host frame cadence: {:.1f} Hz, mean {:.2f} ms, max {:.2f} ms, slow {}/{}, {}",
+                  1000.0 * samples / total_ms, total_ms / samples, maximum_ms,
+                  slow_frames, samples, g_in_menu ? "menu" : "level");
+      total_ms = maximum_ms = 0;
+      samples = slow_frames = 0;
+    }
+  }
   if (rex::perf::TraceEvent) {
     rex::perf::TraceEvent("frame_start", 0);
   }
